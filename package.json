{
  "name": "ai-bot",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "GPT Codex Telegram bot with isolated user containers and migrated conversations",
  "engines": {
    "node": ">=22.5"
  },
  "scripts": {
    "dev": "node --watch gpt/main.mjs",
    "start": "node gpt/main.mjs",
    "build": "tsc -p tsconfig.json && node scripts/build-miniapp.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --test gpt/*.test.mjs",
    "test:e2e": "tsx --test test/miniapp.e2e.ts",
    "miniapp": "tsx scripts/serve-miniapp.ts",
    "cats": "tsx scripts/render-cats.ts",
    "keygen": "node --input-type=module -e \"import{randomBytes}from'node:crypto';console.log(randomBytes(32).toString('base64'))\"",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint:sh": "shellcheck scripts/*.sh",
    "test:gpt": "node --test gpt/*.test.mjs",
    "test:legacy": "tsx --test test/logic.test.ts"
  },
  "dependencies": {
    "grammy": "^1.30.0",
    "https-proxy-agent": "^7.0.6",
    "undici": "^8.10.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.10.0",
    "eslint": "^10.8.1",
    "playwright-core": "^1.63.0",
    "prettier": "^3.9.6",
    "shellcheck": "^4.1.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.67.0",
    "@anthropic-ai/claude-agent-sdk": "^0.3.280"
  }
}
