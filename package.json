{
  "name": "claude-telegram",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Полноценный Claude Code в Telegram: агент, пермишены кнопками, Mini App с котами",
  "engines": {
    "node": ">=22.5"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "node --experimental-sqlite dist/index.js",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "tsx --test test/logic.test.ts",
    "miniapp": "tsx scripts/serve-miniapp.ts",
    "cats": "tsx scripts/render-cats.ts",
    "keygen": "node --input-type=module -e \"import{randomBytes}from'node:crypto';console.log(randomBytes(32).toString('base64'))\"",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint:sh": "shellcheck scripts/*.sh"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.258",
    "grammy": "^1.30.0",
    "https-proxy-agent": "^7.0.6",
    "undici": "^8.10.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.10.0",
    "eslint": "^10.8.1",
    "prettier": "^3.9.6",
    "shellcheck": "^4.1.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.67.0"
  }
}
