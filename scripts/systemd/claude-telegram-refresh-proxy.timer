[Unit]
Description=Проверять каналы VPN каждые полчаса

[Timer]
# Проба дешёвая — пять запросов через прокси, — а простой дорогой: полчаса это
# верхняя граница того, сколько бот может простоять без единого живого канала,
# пока никто не смотрит.
OnUnitActiveSec=30min
# После перезагрузки не бежим сразу: докеру нужно поднять контейнеры.
OnBootSec=10min
# Ровные получасы у всех подписчиков разом провайдеру ни к чему.
RandomizedDelaySec=3min

[Install]
WantedBy=timers.target
