[Unit]
Description=Проверять каналы VPN каждые десять минут

[Timer]
# Проба дешёвая — все порты одним контейнером, — а простой дорогой: десять
# минут — верхняя граница того, сколько может копиться деградация каналов,
# пока никто не смотрит.
OnUnitActiveSec=10min
# После перезагрузки не бежим сразу: докеру нужно поднять контейнеры.
OnBootSec=10min
# Ровные интервалы у всех подписчиков разом провайдеру ни к чему.
RandomizedDelaySec=3min

[Install]
WantedBy=timers.target
