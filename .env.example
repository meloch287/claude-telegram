# ── Telegram ───────────────────────────────────────────────────────────────
# Токен от @BotFather
BOT_TOKEN=123456:AA...

# Кто имеет доступ к боту. Telegram user id через запятую.
# ПУСТОЕ ЗНАЧЕНИЕ = доступ у всех. Никогда не оставляй пустым на публичном сервере:
# любой, кто найдёт бота, получит шелл на твоей машине.
ALLOWED_USER_IDS=123456789

# ── Ключ шифрования ────────────────────────────────────────────────────────
# 32 байта в base64. Сгенерировать: npm run keygen
# Им шифруются API-ключи пользователей в БД. Потеряешь — все ключи придётся вводить заново.
ENCRYPTION_KEY=

# ── Режим авторизации ──────────────────────────────────────────────────────
# owner  — бот личный: ключ берётся из OWNER_ANTHROPIC_API_KEY, никто ничего не вводит
# byok   — каждый пользователь вводит свой ANTHROPIC_API_KEY (bring your own key)
AUTH_MODE=owner
OWNER_ANTHROPIC_API_KEY=sk-ant-...

# ── Рабочие директории ─────────────────────────────────────────────────────
# Корень, внутри которого агент работает. Для каждого чата создаётся подпапка.
WORKSPACE_ROOT=./workspaces

# ── Mini App ───────────────────────────────────────────────────────────────
MINIAPP_PORT=8788
# Публичный HTTPS-URL мини-аппа (Telegram требует https).
# Локально можно прокинуть через cloudflared/ngrok. Пусто = кнопка мини-аппа скрыта.
MINIAPP_URL=

# ── Прочее ─────────────────────────────────────────────────────────────────
# Сколько минут ждать нажатия кнопки разрешения, прежде чем автоматически отказать.
PERMISSION_TIMEOUT_MIN=30
DATA_DIR=./data
