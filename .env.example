# ── Telegram ───────────────────────────────────────────────────────────────
# Токен от @BotFather
BOT_TOKEN=123456:AA...

# Кто имеет доступ к боту. Telegram user id через запятую.
# ПУСТОЕ ЗНАЧЕНИЕ = доступ у всех. Никогда не оставляй пустым на публичном сервере:
# любой, кто найдёт бота, получит шелл на твоей машине.
ALLOWED_USER_IDS=123456789

# ── Ключ шифрования ────────────────────────────────────────────────────────
# 32 байта в base64. Сгенерировать: npm run keygen
# Им шифруются API-ключи пользователей в БД. Потеряешь — все ключи придётся вводить заново.
ENCRYPTION_KEY=

# ── Рабочие директории ─────────────────────────────────────────────────────
# Корень, внутри которого агент работает. Для каждого чата создаётся подпапка.
WORKSPACE_ROOT=./workspaces

# ── Mini App ───────────────────────────────────────────────────────────────
MINIAPP_PORT=8788
# Публичный HTTPS-URL мини-аппа (Telegram требует https).
# Локально можно прокинуть через cloudflared/ngrok. Пусто = кнопка мини-аппа скрыта.
MINIAPP_URL=

# ── Выход в интернет ───────────────────────────────────────────────────────
# Нужен ли прокси, сервис определяет сам на старте: делает запрос без
# авторизации к api.anthropic.com. 401 = дошли, канал рабочий. 403 = блокировка
# по географии, нужен прокси.
#
# Пул через запятую, порядок задаёт приоритет. Первый рабочий становится
# активным. Пусто = только прямой выход.
PROXY_POOL=

# Ожидаемая страна выхода, например DE. Если активный прокси окажется из другой
# страны, сервис его всё равно возьмёт (рабочий канал лучше неработающего), но
# напишет предупреждение в лог и покажет реальную страну в /status.
PROXY_REQUIRE_COUNTRY=

# ── GitHub ─────────────────────────────────────────────────────────────────
# Токен даёт агенту доступ к репозиториям: git подставляет его через credential
# helper, gh читает как GH_TOKEN. В файлы конфигурации токен не попадает —
# только в окружение подпроцесса.
#
# Взять готовый: gh auth token. Права `repo` открывают запись во ВСЕ
# репозитории, включая приватные, — вместе с режимом «без вопросов» это значит,
# что агент может туда пушить. Осознанно выдавай минимум нужного.
GITHUB_TOKEN=

# ── Прочее ─────────────────────────────────────────────────────────────────
# Сколько минут ждать нажатия кнопки разрешения, прежде чем автоматически отказать.
PERMISSION_TIMEOUT_MIN=30
DATA_DIR=./data

# Расшифровка голосовых: любой сервис с интерфейсом OpenAI
# (POST /v1/audio/transcriptions, поле file). Пусто — бот честно скажет,
# что голос не разберёт, вместо того чтобы молчать.
# Проверено на Polza: этот адрес принимает ogg/opus из Telegram как есть.
WHISPER_URL=https://api.polza.ai/v1/audio/transcriptions
WHISPER_MODEL=whisper-1
WHISPER_TOKEN=
# Голос идёт напрямую. 1 — только если сервис недоступен без обхода.
WHISPER_VIA_PROXY=

# ── Потолки окон подписки ──────────────────────────────────────────────────
# Нужны, чтобы показывать «сколько потрачено из 100%».
#
# Своё число, а не от Anthropic: настоящий процент приходит с claude.ai, а он
# с датацентрового адреса отдаёт проверку Cloudflare. Поэтому знаменатель
# задаёшь ты и видишь, от чего считается. Пусто — процент не показывается,
# остаётся абсолютный расход.
#
# Расход считается по транскриптам Claude Code вместе с кэшем: подписка
# тратится именно так. Посмотри свои числа в /status и поставь потолок с
# запасом над обычной нагрузкой.
LIMIT_FIVE_HOUR_TOKENS=
LIMIT_SEVEN_DAY_TOKENS=

# ── Озвучка ответов ────────────────────────────────────────────────────────
# Адрес сервиса синтеза с интерфейсом OpenAI (POST /v1/audio/speech).
# По умолчанию берётся от WHISPER_URL: у одного сервиса это соседние ручки.
# Пусто — бот отвечает только текстом.
#
# Проверено на Polza: отвечает JSON с mp3 в base64, Telegram принимает его
# как голосовое.
TTS_URL=
TTS_MODEL=openai/gpt-4o-mini-tts
TTS_VOICE=alloy
TTS_TOKEN=
# Синтез идёт напрямую. 1 — только если сервис недоступен без обхода.
TTS_VIA_PROXY=

# MCP-серверы в формате Claude Code: { "mcpServers": { … } }
MCP_CONFIG=
